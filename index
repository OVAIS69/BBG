<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#fff0f6">
<title>For Aaqeeb ♡</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@600;700;800&display=swap');
:root{--pink:#ff7eae;--rose:#f45f9a;--ink:#573b50;--cream:#fff8fb;--lilac:#e9ddff}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;color:var(--ink);font-family:'DM Sans',sans-serif;background:radial-gradient(circle at 15% 10%,#ffe0ec 0,transparent 30%),radial-gradient(circle at 90% 30%,#e9ddff 0,transparent 32%),#fff8fb;overflow-x:hidden}
button{font:inherit;cursor:pointer;border:0}.wrap{max-width:980px;margin:auto;padding:24px}.hero{min-height:94vh;display:grid;place-items:center;text-align:center;position:relative;padding:70px 20px}.eyebrow{letter-spacing:.2em;text-transform:uppercase;font-size:.72rem;font-weight:700;color:#c05c8b}.hero h1{font:800 clamp(3.5rem,12vw,7.5rem)/.95 'Playfair Display',serif;margin:18px 0;color:#8c5278;letter-spacing:-.06em}.hero h1 span{color:var(--rose)}.subtitle{font-size:clamp(1rem,2.5vw,1.2rem);max-width:560px;line-height:1.8;margin:0 auto 28px;color:#80647a}.pill{display:inline-flex;align-items:center;gap:8px;padding:10px 16px;border:1px solid #f5c6d9;background:#ffffffb8;border-radius:999px;font-size:.85rem}.primary{background:linear-gradient(135deg,#ff8fba,#ed6da7);color:white;padding:15px 23px;border-radius:999px;box-shadow:0 10px 25px #ed6da744;font-weight:700;transition:.2s}.primary:hover{transform:translateY(-3px);box-shadow:0 14px 30px #ed6da766}.secondary{background:white;color:#a4517b;border:1px solid #f4c6d9;padding:12px 18px;border-radius:999px;font-weight:700}.sparkle{position:absolute;font-size:clamp(1.3rem,4vw,2.5rem);animation:float 4s ease-in-out infinite}.s1{top:16%;left:12%}.s2{top:25%;right:13%;animation-delay:1s}.s3{bottom:17%;left:18%;animation-delay:2s}.s4{bottom:20%;right:17%;animation-delay:.5s}@keyframes float{50%{transform:translateY(-16px) rotate(12deg)}}section{padding:74px 0}.section-head{text-align:center;margin-bottom:28px}.section-head h2{font:700 clamp(2rem,6vw,3rem) 'Playfair Display',serif;margin:8px 0}.section-head p{color:#92758b;margin:0}.card{background:#ffffffc9;border:1px solid #f4d6e3;border-radius:28px;padding:clamp(22px,5vw,38px);box-shadow:0 18px 55px #b85d8410;backdrop-filter:blur(12px)}.gift-area{text-align:center}.gift{font-size:6rem;display:inline-block;filter:drop-shadow(0 12px 10px #d8799c35);transition:.25s;animation:bob 2.5s ease-in-out infinite}.gift:hover{transform:scale(1.12) rotate(-6deg)}@keyframes bob{50%{translate:0 -9px}}.gift-open{display:none;margin:22px auto 0;max-width:600px;line-height:1.8}.gift-open.show{display:block;animation:appear .7s ease}@keyframes appear{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}.letter{font:500 1.06rem/2 'DM Sans',sans-serif;white-space:pre-line;color:#70536b}.letter strong{color:#b84f83}.memory-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px}.memory{min-height:150px;border-radius:20px;padding:18px;display:grid;place-items:center;text-align:center;background:linear-gradient(145deg,#ffe2ed,#f2eaff);border:1px solid #f5d4e3}.memory:nth-child(2){background:linear-gradient(145deg,#f3e8ff,#ffe6f0)}.memory:nth-child(3){background:linear-gradient(145deg,#fff0d9,#ffe4ef)}.memory b{display:block;font:700 1.15rem 'Playfair Display',serif;margin:7px}.memory small{color:#8b6c83;line-height:1.5}.counter{font:800 clamp(3rem,10vw,5rem) 'Playfair Display',serif;color:#e66d9f;text-align:center}.counter-label{text-align:center;color:#8c7185}.chaos{text-align:center}.chaos-output{font:700 1.3rem 'Playfair Display',serif;min-height:72px;display:grid;place-items:center;margin:20px 0;color:#a34c7a}.footer{text-align:center;padding:45px 20px 65px;color:#9a7a91}.heart{color:#ee6b9d}.music{position:fixed;right:18px;bottom:18px;z-index:5;border-radius:50%;width:52px;height:52px;background:#fff;color:#b44e80;box-shadow:0 8px 24px #a44d742b;border:1px solid #f3cadd;font-size:1.25rem}.confetti{position:fixed;top:-20px;z-index:10;pointer-events:none;animation:fall linear forwards}@keyframes fall{to{transform:translateY(110vh) rotate(720deg);opacity:.2}}.tiny{font-size:.8rem;color:#a18498;margin-top:12px}
@media(max-width:650px){.memory-grid{grid-template-columns:1fr}.memory{min-height:120px}.hero{min-height:88vh}.wrap{padding:18px}section{padding:52px 0}.s1{left:5%}.s2{right:5%}}
</style>
</head>
<body>
<main>
  <header class="hero">
    <div class="sparkle s1">✦</div><div class="sparkle s2">♡</div><div class="sparkle s3">✧</div><div class="sparkle s4">🌷</div>
    <div>
      <div class="pill">🎀 a tiny internet surprise · made with love</div>
      <p class="eyebrow" style="margin-top:28px">TODAY IS YOUR DAY</p>
      <h1>Happy Birthday,<br><span>Aaqeeb!</span></h1>
      <p class="subtitle">Seven years of friendship, countless conversations, questionable jokes and still somehow… you haven't blocked me. Iconic. 😭</p>
      <button class="primary" onclick="document.querySelector('#surprise').scrollIntoView({behavior:'smooth'})">Your surprise is waiting ↓</button>
      <div class="tiny">P.S. yes, I made you a whole website. You are welcome. ✨</div>
    </div>
  </header>

  <div class="wrap">
    <section id="surprise">
      <div class="section-head"><div class="eyebrow">THE IMPORTANT BUTTON</div><h2>One little gift for you 🎁</h2><p>Go on. Tap it. Don't be shy.</p></div>
      <div class="card gift-area">
        <button class="gift" id="gift" aria-label="Open your birthday gift" onclick="openGift()">🎁</button>
        <div><button class="primary" onclick="openGift()">OPEN YOUR GIFT</button></div>
        <div class="gift-open" id="giftMessage">
          <h2 style="font:700 2rem 'Playfair Display';color:#b44e80">SURPRISEEEE! 💗</h2>
          <p>Congratulations! You have officially unlocked another year of being a certified legend, professional chaos creator and my favourite notification to see pop up.</p>
          <p><b>Your gift:</b> unlimited good wishes, a lifetime supply of laughs, and a friend who is still here after SEVEN WHOLE YEARS. 🫶</p>
          <div style="font-size:2rem">🍰 🧸 🌸 ✨</div>
        </div>
      </div>
    </section>

    <section>
      <div class="section-head"><div class="eyebrow">A LITTLE NOTE</div><h2>From my side of the screen 💌</h2></div>
      <div class="card letter">Dear Aaqeeb,

HAPPIEST BIRTHDAYYY! 🥳

It's honestly wild that we've been friends for seven years through a screen. Seven years of messages, random conversations, laughs, and all the little moments that somehow turned into a friendship I genuinely value.

We've never needed to be in the same room for you to become a part of my life. Distance is just geography doing too much. 😭

I hope this new year brings you the kind of happiness that stays, people who make you feel appreciated, dreams that come true, and enough plot twists to keep life interesting (but please, only the good ones).

Never stop being your chaotic, wonderful self. Keep smiling, keep growing, and keep being you.

<strong>Thank you for being my friend for all these years.</strong> Here's to more memories, more nonsense, and many more birthdays to celebrate.

With lots of love,
<strong>Your online human 🫶</strong></div>
    </section>

    <section>
      <div class="section-head"><div class="eyebrow">SEVEN YEARS?!</div><h2>That's a whole era 🥹</h2><p>Not just an online friend. A long-running subscription to chaos.</p></div>
      <div class="card">
        <div class="counter">7 YEARS</div>
        <p class="counter-label">of friendship and counting… ♡</p>
        <div class="memory-grid" style="margin-top:28px">
          <div class="memory"><div><span style="font-size:2rem">💬</span><b>Endless chats</b><small>From “hey” to conversations that have no business being this long.</small></div></div>
          <div class="memory"><div><span style="font-size:2rem">😂</span><b>Inside jokes</b><small>Funny to us. Completely unexplainable to everyone else.</small></div></div>
          <div class="memory"><div><span style="font-size:2rem">🌍</span><b>Across the screen</b><small>Different places, one friendship that kept showing up.</small></div></div>
        </div>
      </div>
    </section>

    <section>
      <div class="section-head"><div class="eyebrow">A VERY SERIOUS TEST</div><h2>Birthday chaos generator 🤡</h2><p>Tap the button for your official birthday prophecy.</p></div>
      <div class="card chaos">
        <div style="font-size:2.5rem">🔮</div>
        <div class="chaos-output" id="prophecy">Your birthday prophecy awaits…</div>
        <button class="secondary" onclick="newProphecy()">Reveal my destiny ✨</button>
      </div>
    </section>

    <section style="padding-bottom:30px">
      <div class="card chaos">
        <div style="font-size:2.7rem">🎂</div>
        <h2 style="font:700 2.2rem 'Playfair Display';margin:12px 0">One last thing…</h2>
        <p style="line-height:1.8;color:#80647a">I hope you have the loveliest birthday, Aaqeeb. Eat something delicious, laugh way too loudly, take a million pictures, and remember that someone out here is cheering for you.</p>
        <h2 style="font:700 clamp(2rem,7vw,3.3rem) 'Playfair Display';color:#e66d9f;margin:20px 0 8px">HAPPY BIRTHDAY!!</h2>
        <div style="font-size:1.8rem">💗 🎀 🧁 🌷 💗</div>
        <button class="primary" style="margin-top:22px" onclick="celebrate()">CELEBRATE AGAIN 🎉</button>
      </div>
    </section>
  </div>
  <footer class="footer">Made with <span class="heart">♥</span> and a suspicious amount of effort · just for Aaqeeb</footer>
</main>
<button class="music" id="music" title="Toggle birthday tune" aria-label="Toggle birthday tune" onclick="toggleMusic()">♫</button>
<script>
let opened=false, audioCtx=null, musicOn=false, melodyTimer=null, note=0;
function openGift(){if(opened){document.querySelector('#giftMessage').classList.toggle('show');return}opened=true;document.querySelector('#giftMessage').classList.add('show');document.querySelector('#gift').textContent='💝';confetti(90)}
const prophecies=[
"Your next year will contain 87% good vibes and 13% silly decisions. 📈",
"Breaking news: local legend gets even more legendary. Sources: trust me. 🗞️",
"You are legally required to eat cake today. This is not up for debate. 🍰",
"Good luck, good health and absolutely elite Wi-Fi are heading your way. 📶",
"Your main-character era has been renewed for another season. 🎬",
"May your problems be tiny and your food portions be HUGE. 🍕",
"Achievement unlocked: another year of being everyone's favourite chaos. 🏆"
];
function newProphecy(){document.querySelector('#prophecy').textContent=prophecies[Math.floor(Math.random()*prophecies.length)];confetti(18)}
function confetti(n=50){const symbols=['✦','♡','✧','🌸','🎉','💗'];for(let i=0;i<n;i++){let e=document.createElement('div');e.className='confetti';e.textContent=symbols[Math.floor(Math.random()*symbols.length)];e.style.left=Math.random()*100+'vw';e.style.fontSize=(12+Math.random()*20)+'px';e.style.animationDuration=(2.5+Math.random()*3)+'s';e.style.opacity=.55+Math.random()*.45;document.body.appendChild(e);setTimeout(()=>e.remove(),6000)}}
function toggleMusic(){if(musicOn){musicOn=false;clearTimeout(melodyTimer);document.querySelector('#music').textContent='♫';return}musicOn=true;document.querySelector('#music').textContent='Ⅱ';playNote()}
function playNote(){if(!musicOn)return;try{audioCtx=audioCtx||new(window.AudioContext||window.webkitAudioContext)();let notes=[523.25,659.25,783.99,659.25,587.33,698.46,783.99,1046.5];let osc=audioCtx.createOscillator(),gain=audioCtx.createGain();osc.type='sine';osc.frequency.value=notes[note++%notes.length];gain.gain.setValueAtTime(.0001,audioCtx.currentTime);gain.gain.exponentialRampToValueAtTime(.07,audioCtx.currentTime+.03);gain.gain.exponentialRampToValueAtTime(.0001,audioCtx.currentTime+.28);osc.connect(gain);gain.connect(audioCtx.destination);osc.start();osc.stop(audioCtx.currentTime+.3)}catch(e){}melodyTimer=setTimeout(playNote,340)}
function celebrate(){confetti(140);document.querySelector('#surprise').scrollIntoView({behavior:'smooth'})}
</script>
</body>
</html>
